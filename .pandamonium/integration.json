      "default": "external_side_effect",
      "capabilities": {}
    },
    "configuration": [
      {
        "key": "CURSOR_API_KEY",
        "description": "Cursor subscription API key for Composer 2.5 local agents",
        "required": true,
        "secret": true
      },
      {
        "key": "IDE_TRANSCRIPTS_ROOT",
        "description": "Optional read-only IDE transcript tree for fork-from-IDE",
        "required": false,
        "secret": false
      },
      {
        "key": "WORKSPACE_ROOTS",
        "description": "Optional JSON object mapping workspace names to plugin HOME paths",
        "required": false,
        "secret": false
      }
    ],
    "health": {
      "type": "catalog",
      "timeout_seconds": 8
