      "description": "Cursor subscription API key",
      "required": true,
      "secret": true,
      "evidence": {
        "path": ".pandamonium/SETUP.md",
        "quote": "Paste the Cursor subscription API key into Plugins setup."
      }
    }
  ],
  "requirements": [
    "Pandamonium 1.0.70 nameless chrome host",
    "Linux bubblewrap sidecar"
  ],
  "validation": [
    "Enable the plugin, confirm Ready, and check the rail appears without core Cursor names."
  ],
  "manifest": {
    "protocol_version": "jos-extension.v1",
    "extension_id": "cursor-agents",
    "name": "Cursor Agents",
    "version": "0.1.0",
    "source": {
      "url": "https://github.com/Twenty4SevenLabs/cursor-agents.git",
      "revision": "self"
    },
    "runtime": {
      "type": "service",
      "entrypoint": ".pandamonium/adapter.py"
    },
    "capabilities": {
      "descriptor": {
        "type": "inline"
      },
      "schemas": [
        {
          "type": "function",
