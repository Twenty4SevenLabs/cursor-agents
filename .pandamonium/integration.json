  "chrome": [
    {
      "slot": "rail",
      "title": "Agents",
      "icon": "/ui/icon.svg"
    },
    {
      "slot": "sidebar",
      "path": "/ui/sidebar"
    },
    {
      "slot": "overlay",
      "path": "/ui/overlay"
    }
  ],
  "onboarding": [
    {
      "id": "welcome",
      "title": "Cursor Agents is installed",
      "body": "This plugin lets Pandamonium talk to Cursor agents. First we need your Cursor API key. Click Next and we will point at each button.",
      "target": "plugins"
    },
    {
      "id": "get-key",
      "title": "Get your Cursor API key",
      "body": "Open a browser and sign in at cursor.com. Click Dashboard, then Integrations. That page is https://cursor.com/dashboard/integrations . Create a User API Key and copy it. This is not your Cursor password, and it is not the old Cloud Agents key page.",
      "target": "plugins",
      "href": "https://cursor.com/dashboard/integrations",
      "href_label": "Open Cursor dashboard"
    },
    {
      "id": "paste-key",
      "title": "Paste the key here",
      "body": "Plugins setup asks for CURSOR_API_KEY. Paste the key, then click Save setup. Pandamonium keeps it in the plugin vault, not in chat and not in git.",
      "target": "plugins-setup"
    },
    {
      "id": "rail",
      "title": "The Agents button",
      "body": "After setup turns green (Ready), a new button appears on the left rail. Click it to open your agent list. If you do not see it yet, wait a few seconds and finish setup first.",
      "target": "rail"
    },
    {
      "id": "talk",
      "title": "Talk to an agent",
      "body": "The sidebar is the list. The big overlay is the chat. Type a prompt, send it, and wait for Composer 2.5. You can fork an IDE chat into a new Panda-owned agent. Do not try to resume an IDE agent from here.",
      "target": "overlay"
    }
  ]
}
